{
  "name": "pet-dragon",
  "displayName": "Pet Dragon 🐉",
  "description": "A cute animated pixel dragon companion that lives in your sidebar. Feed it, play with it, and watch it grow as you code.",
  "version": "1.1.0",
  "publisher": "sobatteknologi",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "dragon",
    "companion",
    "fun",
    "pixel art"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1033",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "petDragonContainer",
          "title": "Pet Dragon",
          "icon": "media/dragon-icon.svg"
        }
      ]
    },
    "views": {
      "petDragonContainer": [
        {
          "type": "webview",
          "id": "petDragon.view",
          "name": "Pet Dragon",
          "icon": "media/dragon-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "petDragon.feed",
        "title": "Feed the Dragon",
        "category": "Pet Dragon",
        "icon": "$(add)"
      },
      {
        "command": "petDragon.play",
        "title": "Play with the Dragon",
        "category": "Pet Dragon",
        "icon": "$(star-full)"
      },
      {
        "command": "petDragon.breatheFire",
        "title": "Breathe Fire!",
        "category": "Pet Dragon",
        "icon": "$(flame)"
      },
      {
        "command": "petDragon.rename",
        "title": "Rename the Dragon",
        "category": "Pet Dragon",
        "icon": "$(edit)"
      },
      {
        "command": "petDragon.reset",
        "title": "Reset the Dragon",
        "category": "Pet Dragon",
        "icon": "$(debug-restart)"
      },
      {
        "command": "petDragon.focus",
        "title": "Show the Dragon",
        "category": "Pet Dragon"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "petDragon.feed",
          "when": "view == petDragon.view",
          "group": "navigation@1"
        },
        {
          "command": "petDragon.play",
          "when": "view == petDragon.view",
          "group": "navigation@2"
        },
        {
          "command": "petDragon.breatheFire",
          "when": "view == petDragon.view",
          "group": "navigation@3"
        },
        {
          "command": "petDragon.rename",
          "when": "view == petDragon.view",
          "group": "1_actions@1"
        },
        {
          "command": "petDragon.reset",
          "when": "view == petDragon.view",
          "group": "1_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "Pet Dragon",
      "properties": {
        "petDragon.xpPerSave": {
          "type": "number",
          "default": 8,
          "description": "How much XP the dragon earns each time you save a file."
        },
        "petDragon.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the dragon's mood and level in the status bar."
        },
        "petDragon.color": {
          "type": "string",
          "enum": [
            "emerald",
            "crimson",
            "sapphire",
            "amethyst",
            "gold"
          ],
          "default": "emerald",
          "description": "The scale color of your dragon."
        }
      }
    }
  },
  "scripts": {
    "lint": "echo \"no linter configured\""
  }
}
