{
  "name": "pet-dragon",
  "displayName": "Pet Dragon 🐉",
  "description": "Cute pixel-art night dragons that roam a grassy meadow in your Explorer. Hatch a whole herd, feed them, pet them and watch them grow as you code.",
  "version": "1.2.0",
  "publisher": "sobatteknologi",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "dragon",
    "companion",
    "fun",
    "pixel art"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1033",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "petDragon.view",
          "name": "Pet Dragon",
          "icon": "media/dragonIcon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "petDragon.add",
        "title": "Hatch a New Dragon",
        "category": "Pet Dragon",
        "icon": "$(add)"
      },
      {
        "command": "petDragon.remove",
        "title": "Release a Dragon",
        "category": "Pet Dragon",
        "icon": "$(trash)"
      },
      {
        "command": "petDragon.recolor",
        "title": "Change Dragon Color",
        "category": "Pet Dragon",
        "icon": "$(symbol-color)"
      },
      {
        "command": "petDragon.settings",
        "title": "Pet Dragon Settings",
        "category": "Pet Dragon",
        "icon": "$(gear)"
      },
      {
        "command": "petDragon.feed",
        "title": "Feed the Dragons",
        "category": "Pet Dragon"
      },
      {
        "command": "petDragon.play",
        "title": "Play with the Dragons",
        "category": "Pet Dragon"
      },
      {
        "command": "petDragon.breatheFire",
        "title": "Breathe Fire!",
        "category": "Pet Dragon"
      },
      {
        "command": "petDragon.rename",
        "title": "Rename a Dragon",
        "category": "Pet Dragon"
      },
      {
        "command": "petDragon.reset",
        "title": "Reset the Meadow",
        "category": "Pet Dragon"
      },
      {
        "command": "petDragon.focus",
        "title": "Show the Dragons",
        "category": "Pet Dragon"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "petDragon.add",
          "when": "view == petDragon.view",
          "group": "navigation@1"
        },
        {
          "command": "petDragon.remove",
          "when": "view == petDragon.view",
          "group": "navigation@2"
        },
        {
          "command": "petDragon.recolor",
          "when": "view == petDragon.view",
          "group": "navigation@3"
        },
        {
          "command": "petDragon.settings",
          "when": "view == petDragon.view",
          "group": "navigation@4"
        },
        {
          "command": "petDragon.feed",
          "when": "view == petDragon.view",
          "group": "1_care@1"
        },
        {
          "command": "petDragon.play",
          "when": "view == petDragon.view",
          "group": "1_care@2"
        },
        {
          "command": "petDragon.breatheFire",
          "when": "view == petDragon.view",
          "group": "1_care@3"
        },
        {
          "command": "petDragon.rename",
          "when": "view == petDragon.view",
          "group": "2_manage@1"
        },
        {
          "command": "petDragon.reset",
          "when": "view == petDragon.view",
          "group": "2_manage@2"
        }
      ]
    },
    "configuration": {
      "title": "Pet Dragon",
      "properties": {
        "petDragon.xpPerSave": {
          "type": "number",
          "default": 8,
          "description": "How much XP the dragon earns each time you save a file."
        },
        "petDragon.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the dragon's mood and level in the status bar."
        },
        "petDragon.color": {
          "type": "string",
          "enum": [
            "night",
            "emerald",
            "crimson",
            "sapphire",
            "amethyst",
            "gold"
          ],
          "default": "night",
          "description": "Scale color for newly hatched dragons (use the color icon in the view title to recolor existing ones)."
        }
      }
    }
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,html,json}\"",
    "makeIcon": "node scripts/makeIcon.js",
    "previewSprite": "node scripts/previewSprite.js",
    "previewScene": "node scripts/previewScene.js"
  },
  "license": "MIT"
}
